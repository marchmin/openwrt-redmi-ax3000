            };
            mhi_events {
                mhi_event@0 {
                    mhi,num-elements = <0x00000020>;
                    mhi,intmod = <0x00000001>;
                    mhi,msi = <0x00000001>;
                    mhi,priority = <0x00000001>;
                    mhi,brstmode = <0x00000002>;
