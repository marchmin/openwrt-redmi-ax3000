
#include "ipq5018.dtsi"

/ {
	model = "CMCC MR3000D-04";
	compatible = "cmcc,mr3000d-04", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;



    memory {
        device_type = "memory";
        reg = <0x00000000 0x40000000 0x00000000 0x20000000>;
    };
    reserved-memory {
        #address-cells = <0x00000002>;
        #size-cells = <0x00000002>;
        ranges;
        nss@40000000 {
            no-map;
            reg = <0x00000000 0x40000000 0x00000000 0x01000000>;
        };
        uboot@4a800000 {
            no-map;
            reg = <0x00000000 0x4a800000 0x00000000 0x00200000>;
        };
        sbl@4aa00000 {
            no-map;
            reg = <0x00000000 0x4aa00000 0x00000000 0x00100000>;
        };
        smem@4ab00000 {
            no-map;
            reg = <0x00000000 0x4ab00000 0x00000000 0x00100000>;
            linux,phandle = <0x00000013>;
            phandle = <0x00000013>;
        };
        tz@4ac00000 {
            no-map;
            reg = <0x00000000 0x4ac00000 0x00000000 0x00400000>;
        };
        tzapp@4a400000 {
            no-map;
        };
        bt@7000000 {
            no-map;
            reg = <0x00000000 0x07000000 0x00000000 0x00058000>;
            linux,phandle = <0x00000027>;
            phandle = <0x00000027>;
        };
        q6_mem_regions@4B000000 {
