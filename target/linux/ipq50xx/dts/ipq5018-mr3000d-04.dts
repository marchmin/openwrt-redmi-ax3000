                    mhi,event-ring = <0x00000001>;
                    mhi,chan-dir = <0x00000001>;
                    mhi,data-type = <0x00000000>;
                    mhi,doorbell-mode = <0x00000002>;
                    mhi,ee = <0x00000014>;
